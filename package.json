{
  "name": "folio-playwright-framework",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  },
  "scripts": {
    "setup": "npm ci && husky && node scripts/playwright.ts --version",
    "test": "node scripts/playwright.ts test",
    "test:ui": "node scripts/playwright.ts test --ui",
    "test:perf": "PERFORMANCE=true node scripts/playwright.ts test --project=performance --workers=1",
    "test:bdd": "bddgen --config playwright.bdd.config.ts && node scripts/playwright.ts test --config playwright.bdd.config.ts",
    "test:bdd:ui": "bddgen --config playwright.bdd.config.ts && node scripts/playwright.ts test --config playwright.bdd.config.ts --ui",
    "bdd:steps": "bddgen export --config playwright.bdd.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:meta",
    "test:meta": "node --test \"meta/**/*.test.ts\""
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright-bdd": "9.2.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "zod": "^4.6.7"
  }
}
